# Required
DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledger
JWT_SECRET=replace-me-with-output-of-openssl-rand-base64-48
NODE_ENV=development
PORT=3001

# CORS origin for the web app. Comma-separated for multiple.
# In dev, leave as http://localhost:8081 (Expo web default) or * to allow all.
CORS_ORIGIN=http://localhost:8081

# Budget months are split at midnight in this time zone.
BUDGET_TZ=America/Chicago

# Anthropic — required for AI analysis endpoints
ANTHROPIC_API_KEY=

# Finnhub — required for US stock quotes
FINNHUB_API_KEY=

# CoinGecko — optional, free public API works without a key but is rate limited
COINGECKO_API_KEY=

# Twelve Data — free tier (800 calls/day, 8/min). Required for stock/ETF historical charts.
# Sign up at https://twelvedata.com → Dashboard → API Key.
TWELVE_DATA_API_KEY=

# === TRADE EXECUTION ===
# These credentials let the backend place REAL orders. Treat them like passwords —
# never commit this file, never put it in cloud-synced folders.

# Alpaca paper trading (free, fake money, real market data). Sign up at alpaca.markets,
# enable Paper Trading, generate API keys.
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=

# Alpaca live trading (real money). Same dashboard, switch to Live and generate separate keys.
# Leave blank to keep live trading disabled.
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_API_SECRET=

# Coinbase Advanced Trade (real money — Coinbase doesn't offer paper trading).
# Settings → API → Create CDP API Key. Enable View + Trade scopes only,
# do NOT enable Transfer (limits blast radius if key leaks).
COINBASE_API_KEY_NAME=
COINBASE_API_PRIVATE_KEY=
